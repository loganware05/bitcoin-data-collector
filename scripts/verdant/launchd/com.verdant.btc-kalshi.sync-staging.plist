<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.verdant.btc-kalshi.sync-staging</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO_ROOT_PLACEHOLDER/scripts/verdant/sync_verdant_staging.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BTC_KALSHI_REMOTE_ROOT</key>
    <string>/Volumes/Verdant_AI/btc_kalshi</string>
  </dict>
  <!-- Run at login and every 10 minutes to push/pull when the drive reconnects. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>HOME_PLACEHOLDER/Library/Logs/verdant/sync_staging.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PLACEHOLDER/Library/Logs/verdant/sync_staging.stderr.log</string>
  <key>WorkingDirectory</key>
  <string>REPO_ROOT_PLACEHOLDER</string>
</dict>
</plist>
