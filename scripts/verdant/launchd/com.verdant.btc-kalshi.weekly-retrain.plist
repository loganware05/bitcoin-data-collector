<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.verdant.btc-kalshi.weekly-retrain</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO_ROOT_PLACEHOLDER/scripts/verdant/weekly_retrain.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BTC_KALSHI_ROOT</key>
    <string>/Volumes/Verdant_AI/btc_kalshi</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Volumes/Verdant_AI/btc_kalshi/logs/weekly_retrain.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/Verdant_AI/btc_kalshi/logs/weekly_retrain.stderr.log</string>
  <key>WorkingDirectory</key>
  <string>REPO_ROOT_PLACEHOLDER</string>
</dict>
</plist>
